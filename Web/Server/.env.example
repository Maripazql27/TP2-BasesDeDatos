# Copiar este archivo a ".env" (en Web/Server) y completar los valores.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).
# El servidor lee el .env solo al arrancar: si se cambia, reiniciarlo.

# --- Base de datos -----------------------------------------------------------
DB_SERVER=localhost
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Solo si se conecta por una IP (por ejemplo la de Tailscale) y da error de TLS:
# poner aquí el nombre del servidor SQL.
# DB_SERVERNAME=

# --- Servidor web ------------------------------------------------------------
PUERTO=
# Cualquier frase larga; firma la cookie de sesión.
SESION_SECRETO=

# --- Comprobantes por correo (ver Web/Server/Correo.js) ------------------------
# archivo = guarda cada correo como .eml (no sale nada a Internet)
# smtp    = envío real por un servidor SMTP
CORREO_MODO=archivo
# CORREO_CARPETA=correos_enviados

# Solo con CORREO_MODO=smtp:
# SMTP_HOST=
# SMTP_PUERTO=587
# SMTP_SEGURO=no
# SMTP_USUARIO=
# SMTP_CLAVE=
# CORREO_REMITENTE=Banco TP3 <comprobantes@banco-tp3.invalid>
# Los correos del XML son ficticios (@ejemplo.com): todos van a esta dirección.
# CORREO_REDIRIGIR_A=